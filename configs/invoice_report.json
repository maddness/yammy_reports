{
  "name": "Invoice Report",
  "page_size": "A4",
  "orientation": "portrait",
  "fonts": {},
  "text_styles": {
    "company_name": {
      "font": {
        "family": "Arial",
        "size": 28,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.2,
      "text_align": "center",
      "margin_bottom": 10
    },
    "invoice_title": {
      "font": {
        "family": "Arial",
        "size": 20,
        "weight": "bold",
        "color": "#34495e"
      },
      "line_height": 1.3,
      "text_align": "center",
      "margin_bottom": 30
    },
    "section_heading": {
      "font": {
        "family": "Arial",
        "size": 14,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.4,
      "margin_top": 20,
      "margin_bottom": 10
    },
    "body_text": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#333333"
      },
      "line_height": 1.6,
      "margin_bottom": 5
    },
    "total_amount": {
      "font": {
        "family": "Arial",
        "size": 18,
        "weight": "bold",
        "color": "#27ae60"
      },
      "line_height": 1.3,
      "text_align": "right",
      "margin_top": 20
    },
    "footer_text": {
      "font": {
        "family": "Arial",
        "size": 9,
        "weight": "normal",
        "color": "#7f8c8d"
      },
      "line_height": 1.4,
      "text_align": "center",
      "margin_top": 40
    }
  },
  "pages": [
    {
      "name": "invoice_page",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 40,
        "bottom": 40,
        "left": 40
      },
      "charts": [],
      "blocks": [
        {
          "json_path": "company.name",
          "style": "company_name",
          "template": "<h1 style='{{ style_css }}'>{{ data }}</h1>"
        },
        {
          "json_path": "invoice.number",
          "style": "invoice_title",
          "template": "<h2 style='{{ style_css }}'>Invoice #{{ data }}</h2>"
        },
        {
          "json_path": "invoice",
          "style": "body_text",
          "template": "<div style='{{ style_css }}'><strong>Date:</strong> {{ data.date }}<br><strong>Due Date:</strong> {{ data.due_date }}</div>"
        },
        {
          "json_path": "customer",
          "style": "section_heading",
          "template": "<h3 style='{{ style_css }}'>Bill To:</h3>",
          "container_class": "customer-section"
        },
        {
          "json_path": "customer",
          "style": "body_text",
          "template": "<div style='{{ style_css }}'>{{ data.name }}<br>{{ data.address }}<br>{{ data.city }}, {{ data.state }} {{ data.zip }}<br>{{ data.email }}</div>"
        },
        {
          "json_path": "items",
          "style": "section_heading",
          "template": "<h3 style='{{ style_css }}'>Items:</h3>"
        },
        {
          "json_path": "items",
          "style": "body_text",
          "template": "{% for item in data %}<div style='{{ style_css }}; display: flex; justify-content: space-between; border-bottom: 1px solid #ecf0f1; padding: 10px 0;'><div><strong>{{ item.description }}</strong><br><small>Quantity: {{ item.quantity }} × ${{ '%.2f'|format(item.unit_price) }}</small></div><div style='text-align: right;'>${{ '%.2f'|format(item.total) }}</div></div>{% endfor %}",
          "container_class": "items-list"
        },
        {
          "json_path": "invoice.total",
          "style": "total_amount",
          "template": "<div style='{{ style_css }}'>Total: ${{ '%.2f'|format(data) }}</div>"
        },
        {
          "json_path": "company.footer",
          "style": "footer_text",
          "template": "<div style='{{ style_css }}'>{{ data }}</div>"
        }
      ],
      "custom_css": ".items-list { margin: 20px 0; } .customer-section { margin-top: 30px; }"
    }
  ],
  "global_css": "body { font-family: Arial, sans-serif; }"
}
