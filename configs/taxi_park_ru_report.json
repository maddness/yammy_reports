{
  "name": "Отчет по Таксопарку",
  "page_size": "A4",
  "orientation": "portrait",
  "fonts": {},
  "text_styles": {
    "cover_title": {
      "font": {
        "family": "Arial",
        "size": 36,
        "weight": "bold",
        "color": "#ffffff"
      },
      "line_height": 1.2,
      "text_align": "center",
      "margin_bottom": 15
    },
    "cover_subtitle": {
      "font": {
        "family": "Arial",
        "size": 18,
        "weight": "normal",
        "color": "#ffffff"
      },
      "line_height": 1.4,
      "text_align": "center",
      "margin_bottom": 10
    },
    "cover_period": {
      "font": {
        "family": "Arial",
        "size": 16,
        "weight": "normal",
        "color": "#f0f0f0"
      },
      "line_height": 1.4,
      "text_align": "center",
      "margin_bottom": 0
    },
    "page_title": {
      "font": {
        "family": "Arial",
        "size": 24,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.3,
      "text_align": "left",
      "margin_bottom": 25
    },
    "section_heading": {
      "font": {
        "family": "Arial",
        "size": 18,
        "weight": "bold",
        "color": "#34495e"
      },
      "line_height": 1.4,
      "margin_top": 20,
      "margin_bottom": 15
    },
    "body_text": {
      "font": {
        "family": "Arial",
        "size": 12,
        "weight": "normal",
        "color": "#333333"
      },
      "line_height": 1.6,
      "margin_bottom": 12
    },
    "problem_title": {
      "font": {
        "family": "Arial",
        "size": 22,
        "weight": "bold",
        "color": "#e74c3c"
      },
      "line_height": 1.3,
      "text_align": "left",
      "margin_bottom": 20
    },
    "positive_title": {
      "font": {
        "family": "Arial",
        "size": 20,
        "weight": "bold",
        "color": "#27ae60"
      },
      "line_height": 1.3,
      "text_align": "left",
      "margin_bottom": 15
    },
    "suggestion_title": {
      "font": {
        "family": "Arial",
        "size": 14,
        "weight": "bold",
        "color": "#2980b9"
      },
      "line_height": 1.4,
      "margin_bottom": 8
    },
    "suggestion_text": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#555555"
      },
      "line_height": 1.5,
      "margin_bottom": 15
    },
    "disclaimer": {
      "font": {
        "family": "Arial",
        "size": 10,
        "weight": "normal",
        "color": "#ffffff"
      },
      "line_height": 1.4,
      "text_align": "center",
      "margin_top": 0
    },
    "metric_value": {
      "font": {
        "family": "Arial",
        "size": 28,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.2,
      "text_align": "center",
      "margin_bottom": 5
    },
    "metric_label": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#7f8c8d"
      },
      "line_height": 1.3,
      "text_align": "center",
      "margin_bottom": 0
    }
  },
  "pages": [
    {
      "name": "cover",
      "background": {
        "gradient_type": "linear",
        "gradient_direction": "to bottom",
        "gradient_stops": ["#ec008c", "#fc6767", "#a770ef", "#4facfe"]
      },
      "padding": {
        "top": 250,
        "right": 50,
        "bottom": 50,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "report.title",
          "style": "cover_title",
          "template": "<h1 style='{{ style_css }}'>{{ data }}</h1>"
        },
        {
          "json_path": "report.park_name",
          "style": "cover_subtitle",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "report.period",
          "style": "cover_period",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        }
      ],
      "charts": []
    },
    {
      "name": "overview",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 40,
        "bottom": 40,
        "left": 40
      },
      "blocks": [
        {
          "json_path": "report.park_name",
          "style": "page_title",
          "template": "<h2 style='{{ style_css }}'>Общий обзор парка</h2>"
        },
        {
          "json_path": "report.description",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "key_metrics",
          "style": "body_text",
          "template": "<div class='metrics-grid'><div class='metric-card'><div style='font-size: 28px; font-weight: bold; color: #2c3e50; text-align: center; margin-bottom: 5px;'>{{ data.active_drivers }}</div><div style='font-size: 11px; color: #7f8c8d; text-align: center;'>Активных водителей</div></div><div class='metric-card'><div style='font-size: 28px; font-weight: bold; color: #2c3e50; text-align: center; margin-bottom: 5px;'>{{ data.active_cars }}</div><div style='font-size: 11px; color: #7f8c8d; text-align: center;'>Активных автомобилей</div></div><div class='metric-card'><div style='font-size: 28px; font-weight: bold; color: #2c3e50; text-align: center; margin-bottom: 5px;'>{{ (data.total_profit / 1000000) | round(1) }} млн</div><div style='font-size: 11px; color: #7f8c8d; text-align: center;'>Общая прибыль (₽)</div></div><div class='metric-card'><div style='font-size: 28px; font-weight: bold; color: #2c3e50; text-align: center; margin-bottom: 5px;'>{{ (data.total_losses / 1000000) | round(1) }} млн</div><div style='font-size: 11px; color: #7f8c8d; text-align: center;'>Общие расходы (₽)</div></div><div class='metric-card'><div style='font-size: 28px; font-weight: bold; color: #2c3e50; text-align: center; margin-bottom: 5px;'>{{ data.avg_order_cost }} ₽</div><div style='font-size: 11px; color: #7f8c8d; text-align: center;'>Средний чек</div></div><div class='metric-card'><div style='font-size: 28px; font-weight: bold; color: #2c3e50; text-align: center; margin-bottom: 5px;'>{{ (data.total_orders / 1000) | round(1) }}К</div><div style='font-size: 11px; color: #7f8c8d; text-align: center;'>Всего заказов</div></div></div>"
        }
      ],
      "charts": [
        {
          "json_path": "monthly_profit",
          "chart_type": "bar",
          "title": "Прибыль за последние 12 месяцев (₽)",
          "width": 10,
          "height": 4.5,
          "color_scheme": "ocean",
          "labels_field": "month",
          "values_field": "profit",
          "xlabel": "Месяц",
          "ylabel": "Прибыль (₽)",
          "show_values": false,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 25px 0 30px 0; text-align: center; } .metrics-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 25px; } .metric-card { background: #f8f9fa; border-radius: 8px; padding: 20px; border-left: 4px solid #3498db; }"
    },
    {
      "name": "driver_churn",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 40,
        "bottom": 40,
        "left": 40
      },
      "blocks": [
        {
          "json_path": "churn_problem.title",
          "style": "problem_title",
          "template": "<h2 style='{{ style_css }}'>{{ data }}</h2>"
        },
        {
          "json_path": "churn_problem.description",
          "style": "body_text",
          "template": "<div class='problem-description'><p style='{{ style_css }}'>{{ data }}</p></div>"
        },
        {
          "json_path": "churn_problem.details",
          "style": "body_text",
          "template": "<div style='margin-top: 20px;'><h3 style='font-size: 16px; font-weight: bold; color: #34495e; margin-bottom: 12px;'>Причины проблемы:</h3><ul class='details-list'>{% for detail in data %}<li style='margin-bottom: 10px; color: #555; line-height: 1.6;'>{{ detail }}</li>{% endfor %}</ul></div>"
        }
      ],
      "charts": [
        {
          "json_path": "driver_churn",
          "chart_type": "line",
          "title": "Динамика текучести водителей (%)",
          "width": 10,
          "height": 4.5,
          "color_scheme": "vibrant",
          "labels_field": "month",
          "values_field": "churn_rate",
          "xlabel": "Месяц",
          "ylabel": "Текучесть (%)",
          "show_values": false,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 20px 0 25px 0; text-align: center; } .problem-description { background: #fff5f5; border-left: 4px solid #e74c3c; padding: 20px; margin: 20px 0; border-radius: 4px; } .details-list { margin-top: 15px; } .details-list li { margin-bottom: 10px; color: #555; line-height: 1.6; }"
    },
    {
      "name": "maintenance",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 40,
        "bottom": 40,
        "left": 40
      },
      "blocks": [
        {
          "json_path": "maintenance_problem.title",
          "style": "problem_title",
          "template": "<h2 style='{{ style_css }}'>{{ data }}</h2>"
        },
        {
          "json_path": "maintenance_problem.description",
          "style": "body_text",
          "template": "<div class='problem-description'><p style='{{ style_css }}'>{{ data }}</p></div>"
        },
        {
          "json_path": "maintenance_problem.details",
          "style": "body_text",
          "template": "<div style='margin-top: 20px;'><h3 style='font-size: 16px; font-weight: bold; color: #34495e; margin-bottom: 12px;'>Причины проблемы:</h3><ul class='details-list'>{% for detail in data %}<li style='margin-bottom: 10px; color: #555; line-height: 1.6;'>{{ detail }}</li>{% endfor %}</ul></div>"
        }
      ],
      "charts": [
        {
          "json_path": "maintenance_costs",
          "chart_type": "area",
          "title": "Расходы на обслуживание (₽)",
          "width": 10,
          "height": 4.5,
          "color_scheme": "earth",
          "labels_field": "month",
          "values_field": "cost",
          "xlabel": "Месяц",
          "ylabel": "Расходы (₽)",
          "show_values": false,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 20px 0 25px 0; text-align: center; } .problem-description { background: #fff5f5; border-left: 4px solid #e74c3c; padding: 20px; margin: 20px 0; border-radius: 4px; } .details-list { margin-top: 15px; } .details-list li { margin-bottom: 10px; color: #555; line-height: 1.6; }"
    },
    {
      "name": "conclusion",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 40,
        "bottom": 0,
        "left": 40
      },
      "blocks": [
        {
          "json_path": "profit_growth.title",
          "style": "positive_title",
          "template": "<h2 style='{{ style_css }}'>{{ data }}</h2>"
        },
        {
          "json_path": "profit_growth.description",
          "style": "body_text",
          "template": "<div class='positive-block'><p style='{{ style_css }}'>{{ data }}</p></div>"
        },
        {
          "json_path": "suggestions",
          "style": "body_text",
          "template": "<div class='suggestions-section'><h3 style='font-size: 18px; font-weight: bold; color: #2980b9; margin-bottom: 20px;'>Рекомендации:</h3>{% for suggestion in data %}<div class='suggestion-card'><div style='font-size: 14px; font-weight: bold; color: #2980b9; margin-bottom: 8px;'>{{ suggestion.title }}</div><div style='font-size: 11px; color: #555; line-height: 1.5;'>{{ suggestion.description }}</div></div>{% endfor %}</div>"
        },
        {
          "json_path": "disclaimer",
          "style": "disclaimer",
          "template": "<div class='footer-gradient'><p style='{{ style_css }}'>{{ data }}</p></div>"
        }
      ],
      "charts": [],
      "custom_css": ".positive-block { background: #f0fdf4; border-left: 4px solid #27ae60; padding: 20px; margin: 15px 0 30px 0; border-radius: 4px; } .suggestions-section { margin-top: 35px; } .suggestion-card { background: #f8f9fa; border-radius: 8px; padding: 18px; margin-bottom: 15px; border-left: 4px solid #2980b9; } .footer-gradient { margin-top: 40px; background: linear-gradient(to bottom, #ec008c, #fc6767, #a770ef, #4facfe); padding: 25px 40px; margin-left: -40px; margin-right: -40px; min-height: 80px; display: flex; align-items: center; justify-content: center; }"
    }
  ],
  "global_css": "body { font-family: Arial, sans-serif; } ul { margin-left: 20px; }"
}
