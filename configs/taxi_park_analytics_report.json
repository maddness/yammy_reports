{
  "name": "Taxi Park Analytics Report",
  "page_size": "A4",
  "orientation": "portrait",
  "fonts": {},
  "text_styles": {
    "main_title": {
      "font": {
        "family": "Arial",
        "size": 28,
        "weight": "bold",
        "color": "#1a1a1a"
      },
      "line_height": 1.3,
      "text_align": "center",
      "margin_bottom": 10
    },
    "period": {
      "font": {
        "family": "Arial",
        "size": 16,
        "weight": "bold",
        "color": "#666666"
      },
      "line_height": 1.4,
      "text_align": "center",
      "margin_bottom": 5
    },
    "generated_date": {
      "font": {
        "family": "Arial",
        "size": 12,
        "weight": "normal",
        "color": "#999999"
      },
      "line_height": 1.4,
      "text_align": "center",
      "margin_bottom": 40
    },
    "rating_big": {
      "font": {
        "family": "Arial",
        "size": 72,
        "weight": "bold",
        "color": "#2ecc71"
      },
      "line_height": 1.1,
      "text_align": "center",
      "margin_bottom": 10
    },
    "rating_label": {
      "font": {
        "family": "Arial",
        "size": 18,
        "weight": "bold",
        "color": "#555555"
      },
      "line_height": 1.3,
      "text_align": "center",
      "margin_bottom": 50
    },
    "section_title": {
      "font": {
        "family": "Arial",
        "size": 22,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.3,
      "text_align": "left",
      "margin_top": 30,
      "margin_bottom": 20
    },
    "subsection_title": {
      "font": {
        "family": "Arial",
        "size": 16,
        "weight": "bold",
        "color": "#34495e"
      },
      "line_height": 1.3,
      "text_align": "left",
      "margin_top": 20,
      "margin_bottom": 15
    },
    "body_text": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#333333"
      },
      "line_height": 1.6,
      "text_align": "justify",
      "margin_bottom": 15
    },
    "metric_label": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#666666"
      },
      "line_height": 1.5,
      "margin_bottom": 3
    },
    "metric_value": {
      "font": {
        "family": "Arial",
        "size": 16,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.3,
      "margin_bottom": 15
    },
    "table_header": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "bold",
        "color": "#ffffff"
      },
      "line_height": 1.4,
      "text_align": "left"
    },
    "table_cell": {
      "font": {
        "family": "Arial",
        "size": 10,
        "weight": "normal",
        "color": "#333333"
      },
      "line_height": 1.5,
      "text_align": "left"
    },
    "list_title": {
      "font": {
        "family": "Arial",
        "size": 13,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.4,
      "margin_bottom": 8
    },
    "list_content": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#444444"
      },
      "line_height": 1.6,
      "text_align": "justify",
      "margin_bottom": 20
    },
    "warning": {
      "font": {
        "family": "Arial",
        "size": 10,
        "weight": "normal",
        "color": "#7f8c8d"
      },
      "line_height": 1.5,
      "text_align": "justify",
      "margin_bottom": 10
    }
  },
  "pages": [
    {
      "name": "cover",
      "background": {
        "gradient_type": "linear",
        "gradient_direction": "to bottom",
        "gradient_stops": ["#ffffff", "#f5f7fa"]
      },
      "padding": {
        "top": 80,
        "right": 50,
        "bottom": 50,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "meta.title",
          "style": "main_title",
          "template": "<h1 style='{{ style_css }}'>{{ data }}</h1>"
        },
        {
          "json_path": "meta.period",
          "style": "period",
          "template": "<p style='{{ style_css }}'><strong>Период:</strong> {{ data }}</p>"
        },
        {
          "json_path": "meta.generated_date",
          "style": "generated_date",
          "template": "<p style='{{ style_css }}'>Дата формирования: {{ data }}</p>"
        },
        {
          "json_path": "meta",
          "style": "rating_big",
          "template": "<div style='{{ style_css }}'>{{ data.efficiency_rating }}/{{ data.rating_max }}</div>"
        },
        {
          "json_path": "meta",
          "style": "rating_label",
          "template": "<div style='{{ style_css }}'>Рейтинг эффективности таксопарка</div>"
        }
      ],
      "charts": []
    },
    {
      "name": "revenue_and_metrics",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "meta.title",
          "style": "section_title",
          "template": "<h2 style='{{ style_css }}'>Доход парка после расходов</h2>"
        }
      ],
      "charts": [
        {
          "json_path": "monthly_revenue",
          "chart_type": "bar",
          "title": "Доход парка по месяцам (₽)",
          "width": 10,
          "height": 5,
          "color_scheme": "professional",
          "labels_field": "month",
          "values_field": "revenue",
          "xlabel": "Месяц",
          "ylabel": "Доход (₽)",
          "show_values": false,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 20px 0 30px 0; }"
    },
    {
      "name": "key_metrics",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "meta.title",
          "style": "section_title",
          "template": "<h2 style='{{ style_css }}'>Ключевые показатели</h2>"
        },
        {
          "json_path": "key_metrics.revenue",
          "style": "body_text",
          "template": "<div style='margin-bottom: 20px;'><div style='font-size: 11px; color: #666;'>{{ data.label }}</div><div style='font-size: 16px; font-weight: bold; color: #2c3e50;'>{{ \"{:,.0f}\".format(data.value) }} {{ data.currency }}</div><div style='font-size: 10px; color: #27ae60;'>(+{{ data.change_mom }}% к августу, +{{ data.change_yoy }}% год к году)</div></div>"
        },
        {
          "json_path": "key_metrics.active_drivers",
          "style": "body_text",
          "template": "<div style='margin-bottom: 20px;'><div style='font-size: 11px; color: #666;'>{{ data.label }}</div><div style='font-size: 16px; font-weight: bold; color: #2c3e50;'>{{ data.value }} {{ data.unit }}</div><div style='font-size: 10px; color: #27ae60;'>(+{{ data.change_mom }}% к августу, +{{ data.change_yoy }}% год к году)</div></div>"
        },
        {
          "json_path": "key_metrics.churn_rate",
          "style": "body_text",
          "template": "<div style='margin-bottom: 20px;'><div style='font-size: 11px; color: #666;'>{{ data.label }}</div><div style='font-size: 16px; font-weight: bold; color: #2c3e50;'>{{ data.value }}{{ data.unit }}</div><div style='font-size: 10px; color: #c0392b;'>({{ data.change_mom }} п.п. к августу, +{{ data.change_yoy }} п.п. год к году)</div></div>"
        },
        {
          "json_path": "key_metrics.revenue_per_driver",
          "style": "body_text",
          "template": "<div style='margin-bottom: 20px;'><div style='font-size: 11px; color: #666;'>{{ data.label }}</div><div style='font-size: 16px; font-weight: bold; color: #2c3e50;'>{{ data.value }} {{ data.currency }}</div><div style='font-size: 10px; color: #7f8c8d;'>({{ data.change_mom }}% к августу, {{ data.change_yoy }}% год к году)</div></div>"
        },
        {
          "json_path": "key_metrics.profitability",
          "style": "body_text",
          "template": "<div style='margin-bottom: 20px;'><div style='font-size: 11px; color: #666;'>{{ data.label }}</div><div style='font-size: 16px; font-weight: bold; color: #2c3e50;'>{{ data.value }}{{ data.unit }}</div><div style='font-size: 10px; color: #c0392b;'>(+{{ data.change_mom }} п.п. к августу, {{ data.change_yoy }} п.п. год к году)</div></div>"
        }
      ],
      "charts": [],
      "custom_css": ""
    },
    {
      "name": "churn_analysis",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "churn_analysis.title",
          "style": "section_title",
          "template": "<h2 style='{{ style_css }}'>{{ data }}</h2>"
        },
        {
          "json_path": "churn_analysis.summary",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "churn_analysis.details",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        }
      ],
      "charts": [
        {
          "json_path": "churn_analysis.monthly_data",
          "chart_type": "line",
          "title": "Отток водителей по месяцам (%)",
          "width": 10,
          "height": 5,
          "color_scheme": "vibrant",
          "labels_field": "month",
          "values_field": "value",
          "xlabel": "Месяц",
          "ylabel": "Отток (%)",
          "show_values": false,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 30px 0; }"
    },
    {
      "name": "profitability_analysis",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "profitability_analysis.title",
          "style": "section_title",
          "template": "<h2 style='{{ style_css }}'>{{ data }}</h2>"
        },
        {
          "json_path": "profitability_analysis.summary",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "profitability_analysis.details",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        }
      ],
      "charts": [
        {
          "json_path": "profitability_analysis.monthly_data",
          "chart_type": "area",
          "title": "Доходность по Диспетчерской (%)",
          "width": 10,
          "height": 5,
          "color_scheme": "ocean",
          "labels_field": "month",
          "values_field": "value",
          "xlabel": "Месяц",
          "ylabel": "Доходность (%)",
          "show_values": false,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 30px 0; }"
    },
    {
      "name": "positive_and_recommendations",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "meta.title",
          "style": "section_title",
          "template": "<h2 style='{{ style_css }}'>Позитивные моменты и рекомендации</h2>"
        },
        {
          "json_path": "meta.title",
          "style": "subsection_title",
          "template": "<h3 style='{{ style_css }}'>Позитивные моменты</h3>"
        },
        {
          "json_path": "positive_points[0].title",
          "style": "list_title",
          "template": "<div style='{{ style_css }}'>{{ data }}</div>"
        },
        {
          "json_path": "positive_points[0].content",
          "style": "list_content",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "positive_points[1].title",
          "style": "list_title",
          "template": "<div style='{{ style_css }}'>{{ data }}</div>"
        },
        {
          "json_path": "positive_points[1].content",
          "style": "list_content",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "meta.title",
          "style": "subsection_title",
          "template": "<h3 style='{{ style_css }}'>Рекомендации</h3>"
        },
        {
          "json_path": "recommendations[0].title",
          "style": "list_title",
          "template": "<div style='{{ style_css }}'>1. {{ data }}</div>"
        },
        {
          "json_path": "recommendations[0].content",
          "style": "list_content",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "recommendations[1].title",
          "style": "list_title",
          "template": "<div style='{{ style_css }}'>2. {{ data }}</div>"
        },
        {
          "json_path": "recommendations[1].content",
          "style": "list_content",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        }
      ],
      "charts": []
    },
    {
      "name": "warnings",
      "background": {
        "color": "#fef9e7"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "meta.title",
          "style": "section_title",
          "template": "<h2 style='{{ style_css }}'>Предупреждение</h2>"
        },
        {
          "json_path": "warnings[0]",
          "style": "warning",
          "template": "<p style='{{ style_css }}; padding: 15px; background: #fff3cd; border-left: 4px solid #ffc107; margin-bottom: 15px;'>{{ data }}</p>"
        },
        {
          "json_path": "warnings[1]",
          "style": "warning",
          "template": "<p style='{{ style_css }}; padding: 15px; background: #fff3cd; border-left: 4px solid #ffc107;'>{{ data }}</p>"
        }
      ],
      "charts": []
    }
  ],
  "global_css": "body { font-family: Arial, sans-serif; } .chart-container { page-break-inside: avoid; }"
}
