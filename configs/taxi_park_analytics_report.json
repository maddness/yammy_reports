{
  "name": "Taxi Park Analytics Report",
  "page_size": "A4",
  "orientation": "portrait",
  "fonts": {},
  "text_styles": {
    "main_title": {
      "font": {
        "family": "Arial",
        "size": 28,
        "weight": "bold",
        "color": "#1a1a1a"
      },
      "line_height": 1.3,
      "text_align": "center",
      "margin_bottom": 10
    },
    "period": {
      "font": {
        "family": "Arial",
        "size": 16,
        "weight": "bold",
        "color": "#666666"
      },
      "line_height": 1.4,
      "text_align": "center",
      "margin_bottom": 5
    },
    "generated_date": {
      "font": {
        "family": "Arial",
        "size": 12,
        "weight": "normal",
        "color": "#999999"
      },
      "line_height": 1.4,
      "text_align": "center",
      "margin_bottom": 40
    },
    "rating_big": {
      "font": {
        "family": "Arial",
        "size": 72,
        "weight": "bold",
        "color": "#2ecc71"
      },
      "line_height": 1.1,
      "text_align": "center",
      "margin_bottom": 10
    },
    "rating_label": {
      "font": {
        "family": "Arial",
        "size": 18,
        "weight": "bold",
        "color": "#555555"
      },
      "line_height": 1.3,
      "text_align": "center",
      "margin_bottom": 50
    },
    "section_title": {
      "font": {
        "family": "Arial",
        "size": 22,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.3,
      "text_align": "left",
      "margin_top": 30,
      "margin_bottom": 20
    },
    "subsection_title": {
      "font": {
        "family": "Arial",
        "size": 16,
        "weight": "bold",
        "color": "#34495e"
      },
      "line_height": 1.3,
      "text_align": "left",
      "margin_top": 20,
      "margin_bottom": 15
    },
    "body_text": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#333333"
      },
      "line_height": 1.6,
      "text_align": "justify",
      "margin_bottom": 15
    },
    "metric_label": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#666666"
      },
      "line_height": 1.5,
      "margin_bottom": 3
    },
    "metric_value": {
      "font": {
        "family": "Arial",
        "size": 16,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.3,
      "margin_bottom": 15
    },
    "table_header": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "bold",
        "color": "#ffffff"
      },
      "line_height": 1.4,
      "text_align": "left"
    },
    "table_cell": {
      "font": {
        "family": "Arial",
        "size": 10,
        "weight": "normal",
        "color": "#333333"
      },
      "line_height": 1.5,
      "text_align": "left"
    },
    "list_title": {
      "font": {
        "family": "Arial",
        "size": 13,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.4,
      "margin_bottom": 8
    },
    "list_content": {
      "font": {
        "family": "Arial",
        "size": 11,
        "weight": "normal",
        "color": "#444444"
      },
      "line_height": 1.6,
      "text_align": "justify",
      "margin_bottom": 20
    },
    "warning": {
      "font": {
        "family": "Arial",
        "size": 10,
        "weight": "normal",
        "color": "#7f8c8d"
      },
      "line_height": 1.5,
      "text_align": "justify",
      "margin_bottom": 10
    },
    "cover_title": {
      "font": {
        "family": "Arial",
        "size": 64,
        "weight": "bold",
        "color": "#ffffff"
      },
      "line_height": 1.2,
      "text_align": "left",
      "margin_bottom": 20
    },
    "cover_period": {
      "font": {
        "family": "Arial",
        "size": 18,
        "weight": "normal",
        "color": "#ffffff"
      },
      "line_height": 1.4,
      "text_align": "left",
      "margin_bottom": 8
    },
    "cover_date": {
      "font": {
        "family": "Arial",
        "size": 18,
        "weight": "normal",
        "color": "#ffffff"
      },
      "line_height": 1.4,
      "text_align": "left"
    },
    "rating_title": {
      "font": {
        "family": "Arial",
        "size": 24,
        "weight": "bold",
        "color": "#2c3e50"
      },
      "line_height": 1.3,
      "text_align": "left",
      "margin_bottom": 20
    },
    "metric_compact": {
      "font": {
        "family": "Arial",
        "size": 10,
        "weight": "normal",
        "color": "#444444"
      },
      "line_height": 1.4
    },
    "warning_white": {
      "font": {
        "family": "Arial",
        "size": 12,
        "weight": "normal",
        "color": "#ffffff"
      },
      "line_height": 1.6,
      "text_align": "left",
      "margin_bottom": 20
    },
    "warning_title_white": {
      "font": {
        "family": "Arial",
        "size": 28,
        "weight": "bold",
        "color": "#ffffff"
      },
      "line_height": 1.2,
      "text_align": "left",
      "margin_bottom": 40
    }
  },
  "pages": [
    {
      "name": "cover",
      "background": {
        "gradient_type": "linear",
        "gradient_direction": "135deg",
        "gradient_stops": ["#ff6b9d", "#feca57", "#48dbfb", "#c44dff"]
      },
      "padding": {
        "top": 80,
        "right": 50,
        "bottom": 100,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "meta.title",
          "style": "cover_title",
          "template": "<h1 style='{{ style_css }}'>{{ data }}</h1>"
        }
      ],
      "charts": [],
      "custom_css": ".page-cover { min-height: 297mm !important; height: 297mm !important; background-size: cover !important; position: relative; }",
      "custom_html": "<div style='position: absolute; bottom: 50px; left: 50px;'><p style='font-size: 18px; color: #ffffff; line-height: 1.4; margin-bottom: 8px;'>Период {{ data.meta.period }}</p><p style='font-size: 18px; color: #ffffff; line-height: 1.4;'>Дата формирования {{ data.meta.generated_date }}</p></div>"
    },
    {
      "name": "rating_overview",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "meta",
          "style": "rating_title",
          "template": "<h2 style='{{ style_css }}'>Рейтинг эффективности парка</h2>"
        },
        {
          "json_path": "meta",
          "style": "rating_big",
          "template": "<div style='{{ style_css }}; text-align: left; margin-top: 20px;'><span style='font-size: 64px;'>{{ data.efficiency_rating }}</span> <span style='font-size: 36px; color: #888;'>из {{ data.rating_max }}</span></div>"
        }
      ],
      "charts": [
        {
          "json_path": "revenue_comparison",
          "chart_type": "multi_line",
          "title": "",
          "width": 8,
          "height": 4,
          "labels_field": "month",
          "series": [
            {
              "name": "Текущий год",
              "values_field": "current_year",
              "color": "#27ae60"
            },
            {
              "name": "Прошлый год",
              "values_field": "previous_year",
              "color": "#95a5a6"
            }
          ],
          "xlabel": "",
          "ylabel": "Доход (₽)",
          "show_values": false,
          "show_legend": true,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 20px 0 30px 0; float: right; width: 60%; }",
      "custom_html": "<div style='position: absolute; right: 100px; top: 180px; font-size: 28px; font-weight: bold; color: #2c3e50;'>{{ data.total_revenue_formatted }}</div><div style='margin-top: 30px; clear: both;'>{% for metric in data.compact_metrics %}<div style='display: inline-block; width: 24%; margin-right: 1%; margin-bottom: 15px;'><div style='font-size: 10px; color: #666;'>{{ metric.label }}</div><div style='font-size: 14px; font-weight: bold; color: #2c3e50;'>{{ metric.value }}</div><div style='font-size: 9px; color: {{ metric.change_color }};'>{{ metric.change_text }}</div></div>{% endfor %}</div>"
    },
    {
      "name": "churn_analysis",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "churn_analysis.title",
          "style": "section_title",
          "template": "<h2 style='{{ style_css }}'>{{ data }}</h2>"
        },
        {
          "json_path": "churn_analysis.summary",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "churn_analysis.details",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        }
      ],
      "charts": [
        {
          "json_path": "churn_analysis.comparison_data",
          "chart_type": "multi_line",
          "title": "",
          "width": 10,
          "height": 5,
          "labels_field": "month",
          "series": [
            {
              "name": "Текущий год",
              "values_field": "current_year",
              "color": "#27ae60"
            },
            {
              "name": "Прошлый год",
              "values_field": "previous_year",
              "color": "#95a5a6"
            }
          ],
          "xlabel": "Месяц",
          "ylabel": "Отток (%)",
          "show_values": false,
          "show_legend": true,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 30px 0; }"
    },
    {
      "name": "inflow_analysis",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "inflow_analysis.title",
          "style": "section_title",
          "template": "<h2 style='{{ style_css }}'>{{ data }}</h2>"
        },
        {
          "json_path": "inflow_analysis.summary",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "inflow_analysis.details",
          "style": "body_text",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        }
      ],
      "charts": [
        {
          "json_path": "inflow_analysis.comparison_data",
          "chart_type": "multi_line",
          "title": "",
          "width": 10,
          "height": 5,
          "labels_field": "month",
          "series": [
            {
              "name": "Текущий год",
              "values_field": "current_year",
              "color": "#27ae60"
            },
            {
              "name": "Прошлый год",
              "values_field": "previous_year",
              "color": "#95a5a6"
            }
          ],
          "xlabel": "Месяц",
          "ylabel": "Новые водители",
          "show_values": false,
          "show_legend": true,
          "container_class": "chart-container"
        }
      ],
      "custom_css": ".chart-container { margin: 30px 0; }"
    },
    {
      "name": "positive_and_recommendations",
      "background": {
        "color": "#ffffff"
      },
      "padding": {
        "top": 40,
        "right": 50,
        "bottom": 40,
        "left": 50
      },
      "blocks": [],
      "charts": [],
      "custom_css": ".section-container { border: 2px solid #3498db; border-radius: 8px; padding: 20px; margin-bottom: 20px; } .grid-container { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; } .grid-item { padding: 10px; }",
      "custom_html": "<div class='section-container'><h3 style='color: #2c3e50; font-size: 18px; margin-bottom: 20px;'>Позитивные моменты</h3><div class='grid-container'>{% for point in data.positive_points %}<div class='grid-item'><div style='font-size: 13px; font-weight: bold; color: #34495e; margin-bottom: 8px;'>{{ point.title }}</div><div style='font-size: 11px; color: #444; line-height: 1.5;'>{{ point.content }}</div></div>{% endfor %}</div></div><div class='section-container'><h3 style='color: #2c3e50; font-size: 18px; margin-bottom: 20px;'>Рекомендации</h3><div class='grid-container'>{% for rec in data.recommendations %}<div class='grid-item'><div style='font-size: 13px; font-weight: bold; color: #34495e; margin-bottom: 8px;'>{{ loop.index }}. {{ rec.title }}</div><div style='font-size: 11px; color: #444; line-height: 1.5;'>{{ rec.content }}</div></div>{% endfor %}</div></div>"
    },
    {
      "name": "warnings",
      "background": {
        "gradient_type": "linear",
        "gradient_direction": "135deg",
        "gradient_stops": ["#ff6b9d", "#feca57", "#48dbfb", "#c44dff"]
      },
      "padding": {
        "top": 100,
        "right": 50,
        "bottom": 50,
        "left": 50
      },
      "blocks": [
        {
          "json_path": "meta.title",
          "style": "warning_title_white",
          "template": "<h2 style='{{ style_css }}'>Предупреждение</h2>"
        },
        {
          "json_path": "warnings[0]",
          "style": "warning_white",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        },
        {
          "json_path": "warnings[1]",
          "style": "warning_white",
          "template": "<p style='{{ style_css }}'>{{ data }}</p>"
        }
      ],
      "charts": [],
      "custom_html": "<div style='position: absolute; bottom: 50px; right: 50px; width: 80px; height: 80px; background: rgba(255,255,255,0.3); border-radius: 50%; display: flex; align-items: center; justify-content: center;'><span style='font-size: 48px; color: white; font-weight: bold;'>N</span></div>"
    }
  ],
  "global_css": "@page { size: A4; margin: 0; } body { font-family: Arial, sans-serif; margin: 0; padding: 0; } .chart-container { page-break-inside: avoid; } .page { page-break-after: always; }"
}
